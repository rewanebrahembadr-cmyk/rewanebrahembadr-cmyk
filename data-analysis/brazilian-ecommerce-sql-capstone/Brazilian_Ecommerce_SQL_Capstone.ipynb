    {
      "cell_type": "markdown",
      "source": [
        "Order Items Table"
      ],
      "metadata": {
        "id": "J1X9Op2vPS91"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "query = \"\"\"\n",
        "SELECT\n",
        "    COUNT(*) AS total_rows,\n",
        "    COUNT(DISTINCT order_id) AS unique_orders,\n",
        "    SUM(CASE WHEN order_id IS NULL THEN 1 ELSE 0 END) AS null_orders,\n",
        "    SUM(CASE WHEN order_id IS NULL THEN 1 ELSE 0 END) * 100.0 / COUNT(*) AS null_order_rate,\n",
        "    SUM(CASE WHEN order_item_id IS NULL THEN 1 ELSE 0 END) AS null_items,\n",
        "    SUM(CASE WHEN order_item_id IS NULL THEN 1 ELSE 0 END) * 100.0 / COUNT(*) AS null_item_rate\n",
        "FROM order_items;\n",
        "\"\"\"\n",
        "\n",
        "pd.read_sql_query(query, conn)\n"
      ],
