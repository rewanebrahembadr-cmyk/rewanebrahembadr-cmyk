      }
    },
    {
      "cell_type": "code",
      "source": [
        "query = \"\"\"\n",
        "SELECT\n",
        "    order_id,\n",
        "    COUNT(*) AS order_count\n",
        "FROM orders\n",
        "WHERE order_id IS NOT NULL\n",
        "GROUP BY order_id\n",
        "HAVING COUNT(*) > 1;\n",
        "\"\"\"\n",
        "\n",
        "pd.read_sql_query(query, conn)\n"
