        "\n",
        "for table_name, key_column in key_checks.items():\n",
        "\n",
        "    query = f\"\"\"\n",
        "    SELECT\n",
        "        COUNT(*) AS total_rows,\n",
        "        COUNT(DISTINCT {key_column}) AS distinct_keys,\n",
        "        COUNT(*) - COUNT(DISTINCT {key_column}) AS duplicate_key_rows\n",
        "    FROM {table_name};\n",
        "    \"\"\"\n",
        "\n",
        "    result = pd.read_sql_query(query, conn)\n",
        "\n",
        "    print(f\"\\n===== {table_name} =====\")\n",
        "    display(result)"
